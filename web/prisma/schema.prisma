model acc_type {
  acc_type                               String      @id(map: "pk_acc_type") @db.VarChar(2)
  description                            String?     @db.VarChar(40)
  is_bs_type                             Boolean
  gl_mast_gl_mast_acc_typeToacc_type     gl_mast[]   @relation("gl_mast_acc_typeToacc_type")
  pl_format_pl_format_acc_typeToacc_type pl_format[] @relation("pl_format_acc_typeToacc_type")
}

