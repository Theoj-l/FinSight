// Every model below is INTROSPECTED from the database, not managed by Prisma
// migrations: the 17 AutoCount tables plus the anomaly_alert / anomaly_run and
// forecast_run / forecast_value app tables. Source of truth: prisma/finsight_schema.sql.
// Existing DB upgrades use additive SQL: `npm run db:apply -- prisma/upgrade.sql`
// Workflow: edit SQL -> apply upgrade -> `npm run db:pull`
// -> `npm run db:generate`. Do not hand-edit the models.
// `prisma db pull` drops these comments; restore them after pulling.

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev; "debian-openssl-3.0.x" is the query-engine
  // target for the Docker images (node:22-bookworm-slim).
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

