model ar_invoice {
  doc_key                                         BigInt       @id(map: "pk_ar_invoice")
  doc_no                                          String       @db.VarChar(30)
  debtor_code                                     String       @db.VarChar(12)
  doc_date                                        DateTime     @db.Date
  due_date                                        DateTime     @db.Date
  description                                     String?      @db.VarChar(80)
  sales_agent                                     String?      @db.VarChar(12)
  branch_code                                     String?      @db.VarChar(20)
  local_net_total                                 Decimal      @default(0) @db.Decimal(19, 4)
  local_payment_amt                               Decimal      @default(0) @db.Decimal(19, 4)
  outstanding                                     Decimal      @default(0) @db.Decimal(19, 4)
  cancelled                                       Boolean
  branch                                          branch?      @relation(fields: [branch_code], references: [branch_code], onDelete: NoAction, onUpdate: NoAction, map: "fk_ar_invoice_branch_code")
  debtor                                          debtor       @relation(fields: [debtor_code], references: [acc_no], onDelete: NoAction, onUpdate: NoAction, map: "fk_ar_invoice_debtor_code")
  sales_agent_ar_invoice_sales_agentTosales_agent sales_agent? @relation("ar_invoice_sales_agentTosales_agent", fields: [sales_agent], references: [sales_agent], onDelete: NoAction, onUpdate: NoAction, map: "fk_ar_invoice_sales_agent")

  @@index([debtor_code, due_date], map: "ix_ar_invoice_debtor_due")
}

