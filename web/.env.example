# Copy to .env and fill in. .env* is gitignored.
# Next.js and the Prisma CLI both read this file.

# --- Supabase Postgres (Project Settings -> Database -> Connection string) ---
# DATABASE_URL = "Transaction pooler" (port 6543), used by the app at runtime.
# DIRECT_URL   = "Direct connection"  (port 5432), used by Prisma for migrations.
# URL-encode special chars in the password (@ -> %40, etc.).
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20"
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# --- Supabase Auth / client (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# --- ML service ---
ML_SERVICE_URL="http://localhost:8000"
# Shared secret sent as the x-ml-service-token header. Must match ML_SERVICE_TOKEN
# in ml-service/.env
ML_SERVICE_TOKEN="dev-local-token-change-me"

# --- Chatbot (Google Gemini) ---
# Server-side only. Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"

# Chat widget demo mode: "true" makes the widget show canned sample answers
# (with a "Demo mode" banner) instead of calling /api/chat. Handy while the
# chat backend isn't ready. Public (NEXT_PUBLIC_) so the browser can read it;
# restart `npm run dev` after changing it. Leave "false" (or unset) for real answers.
NEXT_PUBLIC_CHAT_MOCK="false"

# --- Text-to-SQL chatbot (optional; /api/chat-sql) ---
# Point the chat widget at it. Leave unset to keep using /api/chat.
# NEXT_PUBLIC_CHAT_ENDPOINT=/api/chat-sql
# The read-only database role it uses (never DATABASE_URL). Create the role with
# lib/text-to-sql/sql/create-readonly-role.sql. Through Supabase's pooler the
# username is finsight_chat_ro.<project-ref>.
CHAT_DATABASE_URL=
# Let the model use the pre-computed profit-and-loss views (recommended), and the
# anomaly/forecast tables (needs lib/text-to-sql/sql/grant-ml-tables.sql first).
TEXT_TO_SQL_VIEWS=true
TEXT_TO_SQL_ML_TABLES=false
